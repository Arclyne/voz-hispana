# Python bytecode from the documentation helper scripts in .github/scripts/.
# A .pyc was committed by accident in aa267e3; this keeps it from happening again.
__pycache__/
*.py[cod]

# Moonwave build output. Moonwave prints this warning itself at the end of every
# build: "Do not commit this folder: you should add it to your .gitignore file."
# `.moonwave-warmup` is the throwaway first pass the Documentation workflow runs
# to populate Moonwave's cached Docusaurus project before enabling Mermaid.
/build/
/.moonwave-warmup/

# Metadatos del Finder de macOS. Los dos que estaban versionados (./.DS_Store y
# src/.DS_Store) se quitaron del control de versiones a peticion del propietario
# del repositorio; esta regla evita que vuelvan.
.DS_Store
